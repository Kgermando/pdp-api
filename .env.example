APP_PORT=8080
APP_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=pdp_db
DB_SSL_MODE=disable

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# SMS Gateway (Africa's Talking or similar)
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=sandbox
SMS_SENDER_ID=PDP

# Backblaze B2 (stockage images & vidéos)
BACKBLAZE_KEY_ID=your_backblaze_key_id
BACKBLAZE_APPLICATION_KEY=your_backblaze_application_key
BACKBLAZE_BUCKET_ID=your_bucket_id
BACKBLAZE_BUCKET_NAME=your_bucket_name
